# Kampiun backend — env contoh
ADDR=:8080
DATABASE_URL=postgres://kampiun:kampiun_dev@127.0.0.1:5432/kampiun?sslmode=disable
JWT_SECRET=REPLACE_64_random_chars
JWT_ACCESS_TTL=72h
STORAGE_DIR=storage/proofs
ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

REDIS_ADDR=localhost:6379

# Telegram (isi token belakangan)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# SMTP — isi kredensial belakangan. Host kosong = email nonaktif.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@kampiun.id
SMTP_FROM_NAME=Kampiun
APP_BASE_URL=http://localhost:5173
